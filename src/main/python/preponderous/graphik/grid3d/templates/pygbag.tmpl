<!-- The page above is pygbag 0.9.3's default template (MIT licensed), with
     one change: its two viewport tags are one (a page's second viewport tag
     replaces the first, which left phones without width=device-width).
     graphik grid3d: the Strata grid relay over pygame's canvas, fed by
     preponderous.graphik.grid3d.web, and a button switching between the 2D
     and 3D views.
     Which view a page starts in: ?view=2d or ?view=3d in its address (for
     testing and sharing; not remembered), else the player's last choice on
     the button (kept in localStorage), else the game's default, the
     button's data-default-view (3d unless the game built with
     templatePath(defaultView="2d")).
     Starting in 3D, the relay's scripts and engine load at once, alongside
     pygbag. The 2D canvas stays on screen until the 3D view is drawing the
     game, and comes back, with the reason in plain words, whenever 3D can't
     start (no WebGL 2, a file missing, too big, the engine failed), or when
     the 3D view stays too slow once the game is drawing in it (see
     watchSpeed() below; that switch is not remembered, and the button
     brings 3D back). A page
     starting in 2D fetches nothing of the 3D view until the button is
     pressed. The relay's files (grid-relay-scene.js and .wasm,
     strata-loader.js, strata-kit.js, grid-relay.js) go next to this page:
     `python -m preponderous.graphik.grid3d.relay` copies them from Strata's
     release at build time. -->
<style>
  /* The page never scrolls. pygbag measures text with a 50000-pixel-wide
     element; without this a phone's browser widens the page to fit it once
     the 3D canvas shows, which pushes the 2D/3D button off screen. */
  html, body { overflow: hidden; }
  /* Strata's loader would cover the page while the 3D view loads and when
     it fails; here the 2D view stays on screen instead, and the note below
     the button says why 3D couldn't start. */
  .sk-loader { display: none !important; }
  #graphik3d-note {
    position: fixed; top: 52px; right: 8px; z-index: 10; max-width: calc(100vw - 16px);
    box-sizing: border-box; padding: 8px 12px; border-radius: 6px; background: #222; color: #eee;
    font: 14px sans-serif; opacity: 0.92;
  }
</style>
<canvas id="relay" hidden tabindex="0" style="position:fixed;inset:0;width:100%;height:100%;z-index:6;touch-action:none;visibility:hidden"></canvas>
<button id="graphik3d" type="button" aria-pressed="false" title="Show the board in 3D" data-default-view="3d"
    style="position:fixed;top:8px;right:8px;z-index:10;font:bold 14px sans-serif;padding:6px 12px;min-width:44px;min-height:36px;border-radius:6px;border:1px solid #444;background:#222;color:#eee;opacity:0.85">3D</button>
<div id="graphik3d-note" role="status" aria-live="polite" hidden></div>
<script>
(function () {
  "use strict";
  // window.Graphik3D: the page's 2D/3D switch, read by grid3d.web.wants3D()
  // and set by grid3d.web.set3D(); its area() by grid3d.web.buttonArea(),
  // its touch() by grid3d.web.touchScreen().
  // Strings and numbers only (pygbag's bridge).
  const button = document.getElementById("graphik3d");
  const note = document.getElementById("graphik3d-note");
  // the relay's scripts, in order, fetched the first time 3D is wanted
  const SCRIPTS = ["strata-loader.js", "strata-kit.js", "grid-relay.js"];
  const STORE = "graphik.view";
  let on = 0, broken = "", scripts = "idle";  // idle, loading, ready, failed
  let fed = false;  // the game has sent the 3D view something to draw
  let noteTimer = 0;
  function canvas2d() { return document.getElementById("canvas"); }
  function canvas3d() { return document.getElementById("relay"); }
  function show2d(visible) {
    const c = canvas2d();
    if (c) c.style.visibility = visible ? "visible" : "hidden";
  }
  function show3d(visible) {
    const c = canvas3d();
    if (!c) return;
    c.style.visibility = visible ? "visible" : "hidden";
    // presses reach the 2D game until the 3D view is drawing
    c.style.pointerEvents = visible ? "" : "none";
  }
  function remembered() {
    try { return window.localStorage.getItem(STORE) || ""; } catch (e) { return ""; }
  }
  function remember(view) {
    try { window.localStorage.setItem(STORE, view); } catch (e) { /* not kept: fine */ }
  }
  function startingView() {
    let asked = "";
    try { asked = (new URLSearchParams(window.location.search).get("view") || "").toLowerCase(); } catch (e) { asked = ""; }
    if (asked === "2d" || asked === "3d") return asked;
    const kept = remembered();
    if (kept === "2d" || kept === "3d") return kept;
    return button.getAttribute("data-default-view") === "2d" ? "2d" : "3d";
  }
  function label() {
    button.setAttribute("aria-pressed", on ? "true" : "false");
    if (broken) {
      button.textContent = "3D unavailable";
      button.title = "No 3D view here: " + broken + ". The 2D view stays.";
    } else {
      button.textContent = on ? "2D" : "3D";
      button.title = on ? "Back to the 2D view" : "Show the board in 3D";
    }
  }
  // Strata's failure codes, in words a player can act on
  const REASONS = {
    "no-webgl2": "this browser can't draw WebGL 2",
    "network": "the 3D engine could not be downloaded",
    "load": "the 3D engine could not be loaded",
    "engine": "the 3D engine failed to start",
    "context-lost": "the 3D view lost its graphics context",
    "slow": "this device draws the 3D view too slowly",
  };
  function plain(reason) {
    reason = String(reason || "").trim();
    return REASONS[reason] || reason || "it could not start";
  }
  // The note stays until the player has been playing a while (a failure
  // can come while pygbag still waits for its first tap): it goes 10
  // seconds after the next press or key, or at once when tapped.
  function tell(text) {
    note.textContent = text;
    note.hidden = false;
    clearTimeout(noteTimer);
    const later = function () {
      window.removeEventListener("pointerdown", later, true);
      window.removeEventListener("keydown", later, true);
      noteTimer = setTimeout(function () { note.hidden = true; }, 10000);
    };
    window.addEventListener("pointerdown", later, true);
    window.addEventListener("keydown", later, true);
  }
  note.addEventListener("click", function () { note.hidden = true; });
  function fail(reason) {
    set(0, plain(reason));
    tell("No 3D view here: " + broken + ". The 2D view stays.");
  }
  function loadScripts(index) {
    if (index === SCRIPTS.length) {
      const relay = window.StrataGridRelay;
      if (!relay) { scripts = "failed"; fail("the 3D view's files did not load"); return; }
      // the 3D view shows once the game has sent it something to draw
      const send = relay.send.bind(relay);
      relay.send = function (message) { fed = true; return send(message); };
      scripts = "ready";
      if (on) start();
      return;
    }
    const tag = document.createElement("script");
    tag.src = SCRIPTS[index];
    tag.async = false;
    tag.onload = function () { loadScripts(index + 1); };
    tag.onerror = function () {
      scripts = "failed";
      fail("the 3D view's files could not be downloaded");
    };
    document.body.appendChild(tag);
  }
  function start() {
    // the engine starts loading at once; the game's Grid3DWebView.open()
    // finds it already loading
    const relay = window.StrataGridRelay;
    // Strata 0.9.0's relay forgets a close() that came while it loaded: it
    // finishes "ready" on a hidden canvas, and request() then returns at once
    // without showing it, so 3D would replace 2D with nothing. Closing it
    // again first makes request() show it (a newer relay does this itself).
    const c = canvas3d();
    if (relay.state() === "ready" && c && c.hidden) relay.close();
    relay.request(JSON.stringify({canvas: "relay", title: document.title || "the 3D view"}));
  }
  function set(value, reason) {
    on = value ? 1 : 0;
    if (reason) broken = String(reason);
    const relay = scripts === "ready" ? window.StrataGridRelay : null;
    if (on && !window.WebGL2RenderingContext) {
      on = 0;
      broken = broken || REASONS["no-webgl2"];
    }
    if (on && relay) {
      start();
    } else if (on && scripts === "idle") {
      scripts = "loading";
      loadScripts(0);
    } else if (on && scripts === "failed") {
      on = 0;
    }
    if (!on) {
      if (relay && relay.state() !== "idle") relay.close();
      fed = false;
      fedAt = 0;
      stopWatching();
      show3d(false);
      show2d(true);
    }
    label();
  }
  // Too slow: the relay's kit first lowers its pixel density to 1, then its
  // quality tier to the lowest; Strata's onSlow then calls a
  // StrataLoader.slow() that does nothing on this page. The page goes back
  // to 2D, saying why, only when the drawing itself stays slow once the kit
  // can go no lower: for SLOW_FOR_MS, every SLOW_WINDOW_MS window has its
  // typical frame (the median time between frames, the page's own
  // requestAnimationFrame) over SLOW_FRAME_MS, with the relay's own drawing
  // (its stats' cpuMs a frame) at least DRAW_SHARE of it, and the kit's own
  // average frame (its stats' frameMs) over SLOW_FRAME_MS too. A game that stops
  // the page now and then (building and sending a board in Python) makes a
  // few long gaps between frames, not a slow typical frame, and a game that
  // is slow every frame is not helped by 2D: neither counts. Counting starts
  // SLOW_GRACE_MS after the game's first message to the 3D view (pygbag's
  // boot, the shaders' first compile and the kit's own steps down are not
  // counted), and stops while the tab is hidden. It is not the player's
  // choice: it is not remembered, the button brings 3D back, and once the
  // player has done that the page leaves 3D alone, however slow, until it
  // is reloaded. ?slow=0 in the address turns this off (for testing on a
  // machine that draws in software).
  const SLOW_FRAME_MS = 66, SLOW_FOR_MS = 5000, SLOW_GRACE_MS = 3000, SLOW_WINDOW_MS = 1000;
  const DRAW_SHARE = 0.25, STALL_MS = 250;
  let fedAt = 0, slowDropped = false, slowAccepted = false;
  let slowWindows = 0, windowStart = 0, sampling = false, lastFrameAt = 0, gaps = [];
  let lastWindow = "";  // the last second's readings, for Graphik3D.speed()
  try { slowAccepted = new URLSearchParams(window.location.search).get("slow") === "0"; } catch (e) { slowAccepted = false; }
  function frameStats(relay) {
    if (typeof relay.stats !== "function") return null;
    try { return JSON.parse(relay.stats()); } catch (e) { return null; }
  }
  function sampleFrame(t) {
    if (!sampling) return;
    if (lastFrameAt) gaps.push(t - lastFrameAt);
    lastFrameAt = t;
    window.requestAnimationFrame(sampleFrame);
  }
  function stopWatching() {
    sampling = false;
    lastFrameAt = 0;
    gaps = [];
    windowStart = 0;
    slowWindows = 0;
  }
  // One window's verdict: true when the kit is at its lowest and the drawing
  // slow, false when not, null when the window was nearly all stall (it
  // neither counts nor starts the count again).
  function slowWindow(relay) {
    const s = frameStats(relay);
    if (!(s && s.quality === 0 && typeof s.dpr === "number" && s.dpr <= 1.01)) return false;
    const sorted = gaps.slice().sort(function (a, b) { return a - b; });
    if (!sorted.length) return null;
    // a stall is a gap far past the window's typical one
    const cut = Math.max(STALL_MS, 3 * sorted[sorted.length >> 1]);
    const kept = sorted.filter(function (ms) { return ms <= cut; });
    if (kept.length < 3) return null;
    const typical = kept[kept.length >> 1];
    lastWindow = JSON.stringify({typical: typical, drawMs: Number(s.cpuMs), frames: sorted.length, stalls: sorted.length - kept.length});
    // the kit's own average (stalls and all) must say slow too: it can only
    // be lower than a slow typical frame when the frames aren't slow
    return typical > SLOW_FRAME_MS && Number(s.cpuMs) >= DRAW_SHARE * typical
        && Number(s.frameMs) > SLOW_FRAME_MS;
  }
  function watchSpeed(relay, now) {
    if (slowAccepted || !fedAt || now - fedAt < SLOW_GRACE_MS || document.hidden
        || typeof window.requestAnimationFrame !== "function") { stopWatching(); return; }
    if (!sampling) {
      sampling = true;
      window.requestAnimationFrame(sampleFrame);
    }
    if (!windowStart || now - windowStart >= SLOW_WINDOW_MS) {
      const verdict = windowStart ? slowWindow(relay) : null;
      if (verdict !== null) slowWindows = verdict ? slowWindows + 1 : 0;
      windowStart = now;
      gaps = [];
      if (typeof relay.resetStats === "function") relay.resetStats();
    }
    if (slowWindows * SLOW_WINDOW_MS < SLOW_FOR_MS) return;
    stopWatching();
    slowDropped = true;
    set(0);
    tell("Back to 2D: " + REASONS.slow + ". Press 3D to try it again.");
  }
  // The 2D canvas hides only once the 3D view is drawing the game, and
  // comes back if 3D fails, so there is always a view on screen.
  setInterval(function () {
    const relay = scripts === "ready" ? window.StrataGridRelay : null;
    if (!relay) return;
    const state = relay.state();
    if (!on) {
      // 2D was chosen while the 3D view loaded: once it is in, it stops
      // drawing (Strata 0.9.0's relay would draw on, hidden, for nothing)
      if (state === "ready") relay.close();
      return;
    }
    const c = canvas3d();
    const drawing = state === "ready" && fed && !(c && c.hidden);
    show3d(drawing);
    if (drawing) {
      show2d(false);
      const now = Date.now();
      if (!fedAt) fedAt = now;
      watchSpeed(relay, now);
    } else if (state.indexOf("failed:") === 0) fail(state.slice(7));
  }, 150);
  button.addEventListener("click", function () {
    if (!broken) {
      // 3D chosen again after it was dropped for being slow: the player's call
      if (!on && slowDropped) slowAccepted = true;
      set(on ? 0 : 1);
      if (!broken) remember(on ? "3d" : "2d");
    }
    if (broken) tell("No 3D view here: " + broken + ". The 2D view stays.");
    const c = on ? canvas3d() : canvas2d();
    if (c && c.focus) c.focus();
  });
  // A touch screen: a coarse pointer, or a touch already seen (a laptop's
  // touch screen), unless the address says ?touch=0 or ?touch=1.
  let touchSeen = false;
  window.addEventListener("touchstart", function () { touchSeen = true; }, {capture: true, passive: true});
  function touchScreen() {
    let asked = "";
    try { asked = new URLSearchParams(window.location.search).get("touch") || ""; } catch (e) { asked = ""; }
    if (asked === "1" || asked === "0") return Number(asked);
    if (touchSeen) return 1;
    try { return window.matchMedia("(pointer: coarse)").matches ? 1 : 0; } catch (e) { return 0; }
  }
  window.Graphik3D = {
    // on, and the relay's scripts are in (so Grid3DWebView.open() can begin)
    wanted: function () { return on && scripts === "ready" ? 1 : 0; },
    set: function (value, reason) { set(Number(value), reason || ""); return on; },
    toggle: function () { return this.set(on ? 0 : 1); },
    unavailable: function () { return broken; },
    // 1 once the page went back to 2D because 3D was too slow (not a
    // failure: the button still offers 3D)
    slowed: function () { return slowDropped ? 1 : 0; },
    // the slow check's last second ({typical, drawMs, frames, stalls}, JSON,
    // "" before the first) and how many slow seconds in a row, for testing
    speed: function () { return JSON.stringify({last: lastWindow ? JSON.parse(lastWindow) : null, slowSeconds: slowWindows}); },
    // the view the page started in: "2d" or "3d"
    starting: startingView,
    // where the button is, in CSS pixels from the viewport's top left
    // ("x,y,width,height"), for a game to keep its HUD out of; "" if hidden
    area: function () {
      const r = button.getBoundingClientRect();
      if (!r.width || !r.height) return "";
      return [r.left, r.top, r.width, r.height].map(function (v) { return Math.round(v); }).join(",");
    },
    // 1 on a touch screen, where a game shows its on-screen keys
    touch: touchScreen,
  };
  label();
  if (startingView() === "3d") {
    if (window.WebGL2RenderingContext) set(1);
    else fail("no-webgl2");
  }
})();
</script>
</body>
</html>
